{
  "name": "@journal/desktop",
  "version": "0.16.0",
  "private": true,
  "type": "module",
  "description": "JournalClaw Electron host — window + menu + daemon lifecycle only (zero business semantics).",
  "main": "dist/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "dev": "pnpm run build:main && concurrently -k -n web,app \"pnpm --filter @journal/web dev\" \"wait-on tcp:1420 && electron .\"",
    "start": "pnpm run build:main && electron .",
    "build": "pnpm run build:main && electron-builder",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.19.0",
    "concurrently": "^9.1.0",
    "electron": "33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "~5.8.3",
    "vitest": "^4.1.0",
    "wait-on": "^8.0.1"
  }
}
