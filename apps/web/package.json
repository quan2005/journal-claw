{
  "name": "@journal/web",
  "version": "0.16.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run build:magicui",
    "build": "tsc && npm run build:magicui && vite build",
    "build:magicui": "vite build --config magicui.vite.config.ts && npx tailwindcss -i src/lib/sandbox/magicui/tailwind.css -o src/lib/sandbox/magicui/dist/magicui.bundle.css --minify",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@exampledev/new.css": "^1.1.3",
    "@journal/contracts": "workspace:*",
    "@picocss/pico": "^2.1.1",
    "@tabler/icons-webfont": "^3.36.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2",
    "concrete.css": "^3.1.0",
    "dompurify": "^3.4.0",
    "highlight.js": "^11.11.1",
    "latex.css": "^1.14.0",
    "lucide-react": "^1.7.0",
    "marked": "^18.0.0",
    "neat.style": "^1.0.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tauri-plugin-clipboard-api": "^2.1.11",
    "water.css": "^2.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/cli": "^4.3.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "clsx": "^2.1.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fast-check": "^4.6.0",
    "jsdom": "^28.1.0",
    "motion": "^12.40.0",
    "prettier": "^3.8.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "rough-notation": "^0.5.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^7.0.4",
    "vitest": "^4.1.0"
  }
}
