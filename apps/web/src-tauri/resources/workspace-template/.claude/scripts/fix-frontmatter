#!/usr/bin/env bash
# fix-frontmatter — 修复日志条目的元数据格式问题
#
# 支持三种格式：
#   MDX (.mdx):      YAML frontmatter (--- ... ---)
#   Markdown (.md):  YAML frontmatter (--- ... ---)
#   HTML (.html):    HTML comment metadata (<!-- ... -->)
#
# Usage:
#   .claude/scripts/fix-frontmatter [--dry-run] [FILE...]
#   不传文件则扫描整个 workspace

set -euo pipefail

dry_run=false
files=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run|-n) dry_run=true ;;
    *) files+=("$1") ;;
  esac
  shift
done

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
workspace="$(cd "${script_dir}/../.." && pwd)"

# If no files given, scan workspace
if [[ ${#files[@]} -eq 0 ]]; then
  while IFS= read -r -d '' f; do
    files+=("$f")
  done < <(find "$workspace" -maxdepth 3 \( -name "*.mdx" -o -name "*.md" -o -name "*.html" -o -name "*.htm" \) \
    -not -path "$workspace/.claude/*" \
    -not -path "$workspace/identity/*" \
    -not -path "$workspace/refs/*" \
    -not -path "*/raw/*" \
    -regex ".*/[0-9][0-9][0-9][0-9]/.*" \
    -print0)
fi

fixed=0
skipped=0

for f in "${files[@]}"; do
  [[ -f "$f" ]] || continue

  # Determine format by extension
  is_html=false
  [[ "$f" == *.html || "$f" == *.htm ]] && is_html=true

  if $is_html; then
    # ── HTML comment metadata format ──
    first_line=$(head -1 "$f")
    [[ "$first_line" == "<!--" ]] || continue

    tags_line=""
    summary_line=""
    sources_line=""
    body_start=0
    line_num=0
    in_meta=true

    while IFS= read -r line; do
      line_num=$((line_num + 1))
      [[ $line_num -eq 1 ]] && continue

      if $in_meta; then
        if [[ "$line" == "-->" ]]; then
          in_meta=false
          body_start=$((line_num + 1))
          continue
        fi
        cleaned="${line#\#\# }"
        if [[ "$cleaned" =~ ^tags:\ * ]]; then
          tags_line="$cleaned"
        elif [[ "$cleaned" =~ ^summary:\ * ]]; then
          summary_line="$cleaned"
        elif [[ "$cleaned" =~ ^sources:\ * ]]; then
          sources_line="$cleaned"
        fi
      fi
    done < "$f"

    [[ -n "$tags_line" || -n "$summary_line" || -n "$sources_line" ]] || continue

    if [[ $body_start -eq 0 ]]; then
      body_start=$((line_num + 1))
    fi

    new_fm="<!--"
    [[ -n "$tags_line" ]] && new_fm+=$'\n'"$tags_line"
    [[ -n "$summary_line" ]] && new_fm+=$'\n'"$summary_line"
    [[ -n "$sources_line" ]] && new_fm+=$'\n'"$sources_line"
    new_fm+=$'\n'"-->"

    total_lines=$(wc -l < "$f")
    body=""
    if [[ $body_start -le $total_lines ]]; then
      body=$(tail -n +$body_start "$f")
    fi
    body=$(echo "$body" | sed '/./,$!d')

    if $dry_run; then
      echo "WOULD FIX (HTML): $f"
      echo "  tags: ${tags_line:-<missing>}"
      echo "  summary: ${summary_line:0:60}..."
    else
      {
        printf '%s\n' "$new_fm"
        [[ -n "$body" ]] && printf '%s\n' "$body"
      } > "${f}.tmp"
      mv "${f}.tmp" "$f"
      echo "FIXED: $(basename "$f")"
    fi
    fixed=$((fixed + 1))

  else
    # ── YAML frontmatter format (original .md logic) ──
    first_line=$(head -1 "$f")
    [[ "$first_line" == "---" ]] || continue

    head_block=$(head -15 "$f")
    if ! echo "$head_block" | grep -qE '^## (tags|summary):'; then
      close_count=$(echo "$head_block" | grep -c '^---$' || true)
      if [[ $close_count -ge 2 ]]; then
        continue
      fi
      if ! echo "$head_block" | grep -qE '^(tags|summary):'; then
        continue
      fi
    fi

    tags_line=""
    summary_line=""
    sources_line=""
    body_start=0
    line_num=0
    in_frontmatter=true
    found_close=false

    while IFS= read -r line; do
      line_num=$((line_num + 1))
      [[ $line_num -eq 1 ]] && continue

      if $in_frontmatter; then
        cleaned="${line#\#\# }"

        if [[ "$line" == "---" ]]; then
          found_close=true
          in_frontmatter=false
          body_start=$((line_num + 1))
          continue
        fi

        if [[ "$cleaned" =~ ^tags:\ * ]]; then
          tags_line="$cleaned"
          continue
        fi
        if [[ "$cleaned" =~ ^summary:\ * ]]; then
          summary_line="$cleaned"
          continue
        fi
        if [[ "$cleaned" =~ ^sources:\ * ]]; then
          sources_line="$cleaned"
          continue
        fi

        if [[ -z "${line// /}" ]]; then
          continue
        fi

        in_frontmatter=false
        body_start=$line_num
      fi
    done < "$f"

    if [[ $body_start -eq 0 ]]; then
      body_start=$((line_num + 1))
    fi

    if [[ -z "$tags_line" && -z "$summary_line" && -z "$sources_line" ]]; then
      continue
    fi

    new_fm="---"$'\n'
    [[ -n "$tags_line" ]] && new_fm+="$tags_line"$'\n'
    [[ -n "$summary_line" ]] && new_fm+="$summary_line"$'\n'
    [[ -n "$sources_line" ]] && new_fm+="$sources_line"$'\n'
    new_fm+="---"$'\n'

    total_lines=$(wc -l < "$f")
    body=""
    if [[ $body_start -le $total_lines ]]; then
      body=$(tail -n +$body_start "$f")
    fi
    body=$(echo "$body" | sed '/./,$!d')

    if $dry_run; then
      echo "WOULD FIX (MD): $f"
      echo "  tags: ${tags_line:-<missing>}"
      echo "  summary: ${summary_line:0:60}..."
    else
      {
        printf '%s\n' "$new_fm"
        [[ -n "$body" ]] && printf '%s\n' "$body"
      } > "${f}.tmp"
      mv "${f}.tmp" "$f"
      echo "FIXED: $(basename "$f")"
    fi
    fixed=$((fixed + 1))
  fi
done

echo ""
if $dry_run; then
  echo "Dry run complete: $fixed file(s) would be fixed"
else
  echo "Done: $fixed file(s) fixed"
fi
