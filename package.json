{
  "name": "journal",
  "private": true,
  "version": "0.17.0",
  "type": "module",
  "description": "JournalClaw — 本地优先的个人 Agentic Knowledge Workspace",
  "scripts": {
    "dev": "bun run --filter @journal/web dev",
    "desktop:dev": "bun run --filter @journal/desktop dev",
    "desktop:build": "bun run --filter @journal/desktop build",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "test:e2e": "bun run --filter @journal/web test:e2e",
    "policy:test": "node --test scripts/tests/*.test.mjs",
    "policy:version": "node scripts/version-policy.mjs",
    "lint": "bun run --filter '*' lint",
    "format:check": "node scripts/check-format-baseline.mjs",
    "format:strict": "bunx prettier --check \"**/*.{ts,tsx,md}\"",
    "format": "bunx prettier --write \"**/*.{ts,tsx,md}\"",
    "daemon:dev": "bun run --filter @journal/daemon dev",
    "postinstall": "lefthook install && node scripts/fix-electron.mjs"
  },
  "devDependencies": {
    "lefthook": "^2.1.5",
    "prettier": "^3.8.2"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20",
    "bun": ">=1.1.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
