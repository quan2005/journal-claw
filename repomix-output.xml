  /* === CENTER PANEL === */
  .center {
    flex: 1;
    min-width: 0;
    background: var(--bg);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* Center: Materials list mode */
  .materials-view {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .materials-view.hidden { display: none; }

  .materials-header {
    padding: 20px 24px 12px;
    flex-shrink: 0;
  }
  .materials-header-label {
    font-size: 0.6875rem;
