                marginBottom: 8,
              }}
            >
              <div
                style={{
                  fontSize: 11,
                  color: 'var(--duration-text)',
                  letterSpacing: '0.06em',
                  textTransform: 'uppercase',
                }}
              >
                {t('pluginScopeGlobal')}
              </div>
              <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
                <button
                  onClick={() => openSkillsDir('global')}
                  style={{
                    fontSize: 11,
                    padding: '3px 10px',
