<div class="code-section">
<div class="code-block">
  <div class="fn">谨迹 SandboxPreview 的 buildSrcdoc() — 精简版管道</div>
  <pre><code><span class="kw">export function</span> <span class="fnc">buildJournalSrcdoc</span>(html: <span class="kw">string</span>, options: {
  baseHref?: <span class="kw">string</span>;      <span class="cmt">// 资源相对路径解析</span>
  theme: <span class="str">'light'</span> | <span class="str">'dark'</span>; <span class="cmt">// 主题注入</span>
}): <span class="kw">string</span> {

  <span class="cmt">// 1. Fragment → Full Doc（注入谨迹主题 CSS 变量）</span>
  <span class="kw">const</span> wrapped = isFullDoc(html) ? html : <span class="fnc">wrapJournalShell</span>(html, options.theme);

  <span class="cmt">// 2. 核心安全桥接（从 Open Design 直接复用）</span>
  <span class="kw">const</span> withBase   = <span class="fnc">injectBaseHref</span>(wrapped, options.baseHref);
  <span class="kw">const</span> withShim   = <span class="fnc">injectSandboxShim</span>(withBase);     <span class="cmt">// ★ storage polyfill</span>
  <span class="kw">const</span> withFocus  = <span class="fnc">injectPreviewFocusGuard</span>(withShim); <span class="cmt">// ★ 焦点防护</span>

  <span class="cmt">// 3. 谨迹专属桥接</span>
  <span class="kw">const</span> withTheme  = <span class="fnc">injectThemeBridge</span>(withFocus, options.theme); <span class="cmt">// 主题同步</span>

  <span class="kw">return</span> withTheme;
}</code></pre>
</div>

