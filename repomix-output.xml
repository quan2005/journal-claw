import { describe, it, expect } from 'vitest'
import { render, screen } from '@testing-library/react'
import { MdxRenderer } from '../components/MdxRenderer'
import { parseMdx } from '../lib/mdx-parser'

describe('parseMdx', () => {
  it('parses plain markdown as a single markdown node', () => {
    const nodes = parseMdx('# Hello World')
    expect(nodes).toHaveLength(1)
    expect(nodes[0]).toEqual({ type: 'markdown', content: '# Hello World' })
  })

  it('parses self-closing components', () => {
    const nodes = parseMdx('<Divider />')
    expect(nodes).toHaveLength(1)
    expect(nodes[0]).toMatchObject({
      type: 'component',
      name: 'Divider',
      props: { },
      children: [],
    })
  })

  it('parses components with string props', () => {
    const nodes = parseMdx('<Callout type="info">content</Callout>')
    expect(nodes).toHaveLength(1)
    expect(nodes[0]).toMatchObject({
      type: 'component',
      name: 'Callout',
      props: { type: 'info' },
    })
    const comp = nodes[0]
    if (comp.type === 'component') {
      expect(comp.children).toHaveLength(1)
      expect(comp.children[0]).toEqual({ type: 'markdown', content: 'content' })
    }
  })

  it('parses number and boolean props', () => {
    const nodes = parseMdx('<Progress value={75} max={100} visible />')
    expect(nodes).toHaveLength(1)
    expect(nodes[0]).toMatchObject({
      type: 'component',
      name: 'Progress',
      props: { value: 75, max: 100, visible: true },
    })
  })

  it('parses nested components', () => {
    const nodes = parseMdx('<Cards><Card title="A">one</Card><Card title="B">two</Card></Cards>')
    expect(nodes).toHaveLength(1)
    const cards = nodes[0]
    expect(cards).toMatchObject({ type: 'component', name: 'Cards' })
    if (cards.type === 'component') {
      expect(cards.children).toHaveLength(2)
      expect(cards.children[0]).toMatchObject({
        type: 'component', name: 'Card', props: { title: 'A' },
      })
      expect(cards.children[1]).toMatchObject({
        type: 'component', name: 'Card', props: { title: 'B' },
      })
    }
  })

  it('preserves code blocks in markdown', () => {
    const nodes = parseMdx('Text\n```js\nconst x = 1\n```\nMore')
    expect(nodes).toHaveLength(1)
    expect(nodes[0].type).toBe('markdown')
    if (nodes[0].type === 'markdown') {
      expect(nodes[0].content).toContain('```js')
      expect(nodes[0].content).toContain('const x = 1')
    }
  })

  it('handles mixed markdown and components', () => {
    const nodes = parseMdx('Intro text\n\n<Divider />\n\nMore text')
    expect(nodes).toHaveLength(3)
    expect(nodes[0]).toEqual({ type: 'markdown', content: 'Intro text' })
    expect(nodes[1]).toMatchObject({ type: 'component', name: 'Divider' })
    expect(nodes[2]).toEqual({ type: 'markdown', content: 'More text' })
  })

  it('handles multi-line opening tags', () => {
    const nodes = parseMdx('<Callout\ntype="warning"\ntitle="Note"\n>text</Callout>')
    expect(nodes).toHaveLength(1)
    expect(nodes[0]).toMatchObject({
      type: 'component',
      name: 'Callout',
      props: { type: 'warning', title: 'Note' },
    })
  })

  it('parses lowercase tags as HTML element nodes', () => {
    const nodes = parseMdx('<div>content</div>')
    expect(nodes).toHaveLength(1)
    expect(nodes[0]).toMatchObject({
      type: 'component',
      name: 'div',
      props: {},
    })
  })

  it('parses self-closing br tag as HTML element node', () => {
    const nodes = parseMdx('Line 1<br />Line 2')
    expect(nodes).toHaveLength(3)
    expect(nodes[0]).toEqual({ type: 'markdown', content: 'Line 1' })
    expect(nodes[1]).toMatchObject({ type: 'component', name: 'br', props: {}, children: [] })
    expect(nodes[2]).toEqual({ type: 'markdown', content: 'Line 2' })
  })

  it('handles angle brackets in markdown text', () => {
    const nodes = parseMdx('x < 5 and y > 3')
    expect(nodes).toHaveLength(1)
    expect(nodes[0].type).toBe('markdown')
    if (nodes[0].type === 'markdown') {
      expect(nodes[0].content).toContain('x < 5')
    }
  })
})

describe('MdxRenderer', () => {
  it('renders markdown content', () => {
    render(<MdxRenderer content="Hello **world**" />)
    expect(screen.getByText('Hello')).toBeTruthy()
    expect(screen.getByText('world')).toBeTruthy()
  })

  it('shows error for unknown components', () => {
    render(<MdxRenderer content="<UnknownThing>test</UnknownThing>" />)
    expect(screen.getByText('Unknown component: UnknownThing')).toBeTruthy()
  })
})
