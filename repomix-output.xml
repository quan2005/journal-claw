    }

    #[test]
    fn next_speaker_id_increments_max() {
        let profiles = vec![
            SpeakerProfile {
                id: "00001".into(),
                name: String::new(),
                auto_name: "说话人 1".into(),
                embeddings: vec![],
                created_at: 0,
                last_seen_at: 0,
                recording_count: 1,
