<title>Open Design → 谨迹 整合分析</title>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #f5f5f7;
    --bg-card: #fff;
    --bg-code: #1d1f21;
    --border: #d1d1d6;
    --text: #1d1d1f;
    --text-secondary: #86868b;
    --accent: #0071e3;
    --accent-dim: rgba(0,113,227,0.07);
    --amber: #b8782a;
    --amber-dim: rgba(184,120,42,0.08);
    --green: #34c759;
    --green-dim: rgba(52,199,89,0.08);
    --red: #ff3b30;
    --red-dim: rgba(255,59,48,0.08);
    --purple: #af52de;
    --purple-dim: rgba(175,82,222,0.08);
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #1d1d1f;
      --bg-card: #2d2d2f;
      --bg-code: #1a1a1c;
      --border: #424245;
      --text: #f5f5f7;
      --text-secondary: #86868b;
      --accent: #0a84ff;
      --accent-dim: rgba(10,132,255,0.1);
      --amber: #c8933b;
      --amber-dim: rgba(200,147,59,0.1);
      --green-dim: rgba(52,199,89,0.08);
      --red-dim: rgba(255,59,48,0.08);
      --purple-dim: rgba(175,82,222,0.1);
    }
  }

  body {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "SF Pro Text", sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
  }

  /* ── HERO ── */
  .hero {
    text-align: center;
    padding: 3rem 2rem 2rem;
    max-width: 900px;
    margin: 0 auto;
  }
  .hero h1 { font-size: 2rem; font-weight: 700; letter-spacing: -0.02em; }
  .hero p { color: var(--text-secondary); margin-top: 0.5rem; font-size: 1rem; }

  /* ── PIPELINE COMPARISON ── */
  .pipeline {
    max-width: 1000px;
    margin: 0 auto 2rem;
    padding: 0 2rem;
  }
  .pipeline-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }
  @media (max-width: 700px) { .pipeline-grid { grid-template-columns: 1fr; } }
  .pkg {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
  }
  .pkg-header {
    padding: 0.6rem 1rem;
    font-weight: 700;
    font-size: 0.8rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
