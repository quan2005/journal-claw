import { useCallback, useMemo, createElement, Component, type ReactNode } from 'react'
import ReactMarkdown from 'react-markdown'
import remarkGfm from 'remark-gfm'
import rehypeHighlight from 'rehype-highlight'
import { getWorkspacePath, openFile } from '../lib/tauri'
import { resolveRelativePath } from '../lib/markdownUtils'
import { createMarkdownComponents } from '../lib/markdownComponents'
import { mdxComponents } from './mdx'
import { parseMdx, type MdxNode } from '../lib/mdx-parser'

interface Props {
  content: string
  entryPath?: string
}

interface State {
  hasError: boolean
  error?: Error
}

class MdxErrorBoundary extends Component<{ children: ReactNode; fallback: ReactNode }, State> {
  state: State = { hasError: false }

  static getDerivedStateFromError(error: Error): State {
    return { hasError: true, error }
  }

  render() {
    if (this.state.hasError) {
      return this.props.fallback
    }
    return this.props.children
  }
}

// ── Node renderer ──────────────────────────────────────────────────────────

const compMap = mdxComponents as Record<string, React.ComponentType<any>>

function renderNodes(
  nodes: MdxNode[],
  markdownComponents: ReturnType<typeof createMarkdownComponents>,
): React.ReactNode[] {
  return nodes.map((node, i) => {
    if (node.type === 'markdown') {
      return (
        <ReactMarkdown
          key={i}
          remarkPlugins={[remarkGfm]}
          rehypePlugins={[[rehypeHighlight, { detect: false }]]}
          components={markdownComponents}
        >
          {node.content}
        </ReactMarkdown>
      )
    }

    // Lowercase → native HTML element (e.g. br, hr, img, div)
    const isHtml = /^[a-z]/.test(node.name)
    if (isHtml) {
      return createElement(node.name, { key: i, ...node.props }, ...(
        node.children.length > 0
          ? renderNodes(node.children, markdownComponents)
          : []
      ))
    }

    const Comp = compMap[node.name]
    if (!Comp) {
      return (
        <div key={i} className="mdx-error-banner">
          Unknown component: {node.name}
        </div>
      )
    }

    const children =
      node.children.length > 0
        ? renderNodes(node.children, markdownComponents)
        : undefined

    return createElement(Comp, { key: i, ...node.props }, children)
  })
}

// ── Component ──────────────────────────────────────────────────────────────

export function MdxRenderer({ content, entryPath }: Props) {
  const nodes = useMemo(() => parseMdx(content), [content])

  const markdownComponents = useMemo(
    () => createMarkdownComponents({ entryPath: entryPath || '' }),
    [entryPath],
  )

  const rendered = useMemo(
    () => renderNodes(nodes, markdownComponents),
    [nodes, markdownComponents],
  )

  const handleClick = useCallback(
    async (e: React.MouseEvent<HTMLDivElement>) => {
      const anchor = (e.target as HTMLElement).closest('a')
      if (!anchor) return

      const mdLink = anchor.getAttribute('data-md-link')
      if (mdLink && entryPath) {
        e.preventDefault()
        const entryDir = entryPath.substring(0, entryPath.lastIndexOf('/'))
        const targetPath = resolveRelativePath(entryDir, mdLink)
        const targetFilename = targetPath.substring(targetPath.lastIndexOf('/') + 1)
        window.dispatchEvent(
          new CustomEvent('journal-entry-navigate', {
            detail: { path: targetPath, filename: targetFilename },
          }),
        )
        return
      }

      const filepath = anchor.getAttribute('data-filepath')
      if (filepath) {
        e.preventDefault()
        const ws = await getWorkspacePath()
        openFile(`${ws}/${filepath}`)
        return
      }
      const href = anchor.getAttribute('href')
      if (!href) return
      if (/^https?:\/\//i.test(href)) {
        e.preventDefault()
        openFile(href)
      }
    },
    [entryPath],
  )

  const fallback = (
    <div className="md-content">
      <pre className="mdx-fallback">{content}</pre>
    </div>
  )

  return (
    <div className="md-content" onClick={handleClick}>
      <MdxErrorBoundary key={content} fallback={fallback}>
        {rendered}
      </MdxErrorBoundary>
    </div>
  )
}
</file>

