<script>
// ===== 暗色主题：快照恢复 + 两阶段占位符替换 =====
// 原理：切到深色前保存浅色快照，切回浅色时直接恢复快照（避免反向映射丢失信息）
// 深色替换使用两阶段占位符，防止链式碰撞（如 #3D→#E0 再 #E0→#2a 导致文字变成边框色）

let lightSnapshot = null;

// {{根据你的配色方案填写映射表}}
const darkMap = {
  // 文字：浅色值 → 深色值
  '#3D352C':'#E8E0D4','#635850':'#A89880','#8A8078':'#736D65',
  '#fff':'#E8E0D4',
  // 强调色通常不变或微调
  '#C8933B':'#C8933B',
  // 背景：浅色值 → 深色值
  '#FAFAF8':'#0F0F0F','#F2F1ED':'#181818','#F5F4F1':'#222222',
  '#E5E3DD':'#2a2a2a','#EFEEE9':'#222222',
  '#FBF3E5':'rgba(200,147,59,0.08)',
  '#F7F5F0':'#1a1a1a',
};

const darkGrads = [
  // [浅色渐变, 深色渐变]
  ['linear-gradient(135deg,#3D352C 0%,#5C4A3A 50%,#3D352C 100%)','linear-gradient(135deg,#1a1510 0%,#2a2018 50%,#1a1510 100%)'],
];

function saveSnapshot() {
  lightSnapshot = [];
  document.querySelectorAll('[style]').forEach(el => {
    lightSnapshot.push({ el, style: el.getAttribute('style') });
  });
}

function restoreSnapshot() {
  if (!lightSnapshot) return;
  lightSnapshot.forEach(({ el, style }) => {
    el.setAttribute('style', style);
  });
}

function applyDark() {
  const entries = Object.entries(darkMap);
  const placeholders = entries.map((_,i) => '@@DARK'+i+'@@');

  document.querySelectorAll('[style]').forEach(el => {
    let s = el.getAttribute('style');
    let changed = false;
    // Pass 0: gradients
    darkGrads.forEach(([from, to]) => {
      if (s.includes(from)) { s = s.split(from).join(to); changed = true; }
    });
    // Pass 1: source colors → placeholders
    entries.forEach(([from, _], i) => {
      if (from === darkMap[from]) return;
      if (s.includes(from)) { s = s.split(from).join(placeholders[i]); changed = true; }
    });
    // Pass 2: placeholders → dark values
    if (changed) {
      entries.forEach(([_, to], i) => {
        s = s.split(placeholders[i]).join(to);
      });
      el.setAttribute('style', s);
    }
  });
}

document.addEventListener('DOMContentLoaded', saveSnapshot);

function toggleTheme() {
  const html = document.documentElement;
  const current = html.getAttribute('data-theme') || 'light';
  const next = current === 'light' ? 'dark' : 'light';

  if (next === 'dark') {
    if (!lightSnapshot) saveSnapshot();
    applyDark();
  } else {
    restoreSnapshot();
  }

  html.setAttribute('data-theme', next);
  document.getElementById('theme-label').textContent = next === 'light' ? '深色' : '浅色';
}
</script>
</body>
</html>
</file>

