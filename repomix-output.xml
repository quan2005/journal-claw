mod tests {
    use super::*;

    #[test]
    fn definition_has_required_fields() {
        let def = definition();
        assert_eq!(def.name, "bash");
        assert!(def.input_schema.get("properties").is_some());
    }

    #[tokio::test]
    async fn execute_simple_echo() {
        let input = json!({"command": "echo hello"});
        let result = execute(&input, "/tmp").await;
