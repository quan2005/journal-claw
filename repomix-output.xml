<!-- ────────────────────────────────────
  SECTION 2: DEEP DIVE — THREE KEY PATTERNS
  ──────────────────────────────────── -->
<div class="sect"><h2><span class="num">2</span> 三个核心模式深度剖析</h2><p>逐一分析 Open Design 的实现精髓，及谨迹可复用/改造之处</p></div>

<!-- Pattern A: Streaming Parser -->
<div class="code-section">
<div class="code-block">
  <div class="fn">apps/web/src/artifacts/parser.ts — 流式 Artifact 解析器</div>
  <pre><code><span class="cmt">// Generator 模式：feed(delta) → yield ArtifactEvent</span>
<span class="kw">export type</span> ArtifactEvent =
  | { type: <span class="str">'text'</span>; delta: <span class="kw">string</span> }
  | { type: <span class="str">'artifact:start'</span>; identifier: <span class="kw">string</span>; artifactType: <span class="kw">string</span>; title: <span class="kw">string</span> }
  | { type: <span class="str">'artifact:chunk'</span>; identifier: <span class="kw">string</span>; delta: <span class="kw">string</span> }
  | { type: <span class="str">'artifact:end'</span>; identifier: <span class="kw">string</span>; fullContent: <span class="kw">string</span> };

<span class="kw">function</span>* <span class="fnc">feed</span>(delta: <span class="kw">string</span>): <span class="kw">Generator</span>&lt;ArtifactEvent&gt; {
  state.buffer += delta;
  <span class="cmt">// 开标签检测：处理 partial tag（跨 chunk）、code fence 跳过</span>
  <span class="cmt">// 闭合标签检测：flush 内容，yield artifact:end</span>
  <span class="cmt">// 未闭合时 hold back 尾部数据，等待下一个 chunk</span>
}</code></pre>
</div>

<div style="margin-bottom:1.5rem; padding:0 2rem;">
  <p style="font-size:0.82rem; color:var(--text-secondary);">
    <strong>精髓：</strong>findOpenTag() 的 hold-back 逻辑极其细致——跳过 code fence 内的假标签、
    延迟未闭合的 partial tag、检测尾部可能形成标签的前缀字符。
    这使得解析器可以在<strong>不缓存完整输出</strong>的前提下，安全地边接收边渲染。
  </p>
</div>
</div>

<!-- Pattern B: srcDoc Builder -->
<div class="code-section">
<div class="code-block">
  <div class="fn">apps/web/src/runtime/srcdoc.ts — buildSrcdoc() 桥接注入管道</div>
  <pre><code><span class="kw">export function</span> <span class="fnc">buildSrcdoc</span>(html: <span class="kw">string</span>, options: SrcdocOptions = {}): <span class="kw">string</span> {
  <span class="cmt">// 1. Fragment → Full Doc（与 brainstorming visual companion 同模式）</span>
  <span class="kw">const</span> wrapped = isFullDoc ? html : <span class="str">`&lt;!doctype html&gt;&lt;html&gt;...&lt;body&gt;${html}&lt;/body&gt;&lt;/html&gt;`</span>;

  <span class="cmt">// 2. 桥接注入管道（顺序重要）</span>
  <span class="kw">const</span> withOdIds     = <span class="fnc">annotateMissingOdIds</span>(wrapped);          <span class="cmt">// 元素标记</span>
  <span class="kw">const</span> withBase      = <span class="fnc">injectBaseHref</span>(withOdIds, base);          <span class="cmt">// 相对路径</span>
  <span class="kw">const</span> withShim      = <span class="fnc">injectSandboxShim</span>(withBase);              <span class="cmt">// ★ 核心安全</span>
  <span class="kw">const</span> withFocus     = <span class="fnc">injectPreviewFocusGuard</span>(withShim);        <span class="cmt">// ★ 焦点防护</span>
  <span class="kw">const</span> withDeck      = <span class="fnc">injectDeckBridge</span>(withFocus);              <span class="cmt">// PPT 翻页</span>
  <span class="kw">const</span> withSelection = <span class="fnc">injectSelectionBridge</span>(withDeck);         <span class="cmt">// 元素选择</span>
  <span class="kw">const</span> withPalette   = <span class="fnc">injectPaletteBridge</span>(withSelection);       <span class="cmt">// 调色板</span>
  <span class="kw">const</span> withEdit      = <span class="fnc">injectManualEditBridge</span>(withPalette);      <span class="cmt">// 手动编辑</span>
  <span class="kw">const</span> withTweaks    = <span class="fnc">injectTweaksBridge</span>(withEdit);             <span class="cmt">// 面板切换</span>
  <span class="kw">const</span> withSnapshot  = <span class="fnc">injectSnapshotBridge</span>(withTweaks);        <span class="cmt">// 截图</span>
  <span class="kw">return</span> <span class="fnc">injectSrcdocTransportActivationBridge</span>(withSnapshot); <span class="cmt">// 延迟激活</span>
}</code></pre>
</div>

<div style="display:grid; grid-template-columns: 1fr 1fr; gap:1.5rem; padding:0 2rem; margin-bottom:1.5rem;">
  <div>
    <h4 style="font-size:0.82rem; margin-bottom:0.5rem;">Sandbox Shim（★ 谨迹最需要）</h4>
    <p style="font-size:0.75rem; color:var(--text-secondary);">
      因为 sandbox="allow-scripts" <strong>不含 allow-same-origin</strong>，
      localStorage/sessionStorage 会抛异常。
      Shim 用内存 Map 模拟这两个 API，让依赖 Web Storage 的 artifact 正常运行。
      同时拦截锚点链接和 target="_blank"。
    </p>
  </div>
  <div>
    <h4 style="font-size:0.82rem; margin-bottom:0.5rem;">Focus Guard（★ 谨迹需要）</h4>
    <p style="font-size:0.75rem; color:var(--text-secondary);">
      重写 window.focus() 和 HTMLElement.prototype.focus()，
      仅在<strong>用户交互 1 秒内</strong>才允许元素获得焦点。
      防止嵌入内容劫持键盘焦点（意外触发快捷键等）。
    </p>
  </div>
</div>
</div>

<!-- Pattern C: Live Artifact -->
<div class="code-section">
<div class="code-block">
  <div class="fn">apps/daemon/src/live-artifacts/render.ts — 模板渲染 + 安全验证</div>
  <pre><code><span class="cmt">// 最小的 Mustache 式插值：{{data.xxx.yyy}}</span>
<span class="kw">function</span> <span class="fnc">renderHtmlTemplateV1</span>(templateHtml, data):
  <span class="cmt">// 安全规则（在渲染前验证模板）</span>
  <span class="cmt">//   BLOCK: &lt;script&gt;, &lt;iframe&gt;, srcdoc=, on* event handlers, javascript: URLs</span>
  <span class="cmt">//   ALLOW: 自定义 data-od-* 指令</span>
  <span class="cmt">// 插值值一律 HTML-escape（无 raw 插值）</span>

  <span class="cmt">// 存储结构（.live-artifacts/&lt;id&gt;/）:</span>
  <span class="cmt">//   artifact.json     — 清单（title, slug, sources, preview config）</span>
  <span class="cmt">//   template.html      — 带 {{data.xxx}} 占位符的 HTML</span>
  <span class="cmt">//   data.json          — 数据源输出（经 output mapping 转换后）</span>
  <span class="cmt">//   index.html         — 渲染结果（可预览的最终文件）</span></code></pre>
</div>
</div>

<!-- ────────────────────────────────────
  SECTION 3: GAP ANALYSIS — WHAT TO BRING OVER
  ──────────────────────────────────── -->
<div class="sect"><h2><span class="num">3</span> 差距项 & 整合策略</h2><p>按"可直接复用 / 需改造 / 需新建"分类</p></div>

<div class="gap-bridge">
  <div class="gap-list">

    <div class="gap-item copy">
      <div class="gap-badge badge-copy">复用</div>
      <div class="gap-body">
        <div class="gap-what">Streaming Artifact Parser（流式解析器）</div>
        <div class="gap-why">Generator 模式的 XML 标签解析器几乎可以直接复制到谨迹的 conversation streaming 管道中。Open Design 的 parser.ts 只有 250 行，零依赖，纯逻辑。在谨迹的 useConversation.ts 中对 streaming text 块调用 feed()，yield 出 artifact:start/chunk/end 事件。</div>
        <div class="gap-src">源：<code>apps/web/src/artifacts/parser.ts</code></div>
      </div>
    </div>

    <div class="gap-item copy">
      <div class="gap-badge badge-copy">复用</div>
      <div class="gap-body">
        <div class="gap-what">Sandbox Shim（存储 polyfill）</div>
        <div class="gap-why">injectSandboxShim() 的核心逻辑（in-memory storage + 锚点/外链拦截）完全通用，与业务无关。直接复制到谨迹的 HTML 预处理管道。</div>
        <div class="gap-src">源：<code>apps/web/src/runtime/srcdoc.ts:611-675</code></div>
      </div>
    </div>

    <div class="gap-item copy">
      <div class="gap-badge badge-copy">复用</div>
      <div class="gap-body">
        <div class="gap-what">Preview Focus Guard（焦点防护）</div>
        <div class="gap-why">在谨迹中嵌入的 HTML 内容可能会调用 .focus() 劫持键盘。这个 40 行的脚本直接复制即可。</div>
        <div class="gap-src">源：<code>apps/web/src/runtime/srcdoc.ts:677-710</code></div>
      </div>
    </div>

    <div class="gap-item adapt">
      <div class="gap-badge badge-adapt">改造</div>
      <div class="gap-body">
        <div class="gap-what">Fragment → Full Doc 包裹</div>
        <div class="gap-why">两种现有模式：brainstorming 的 frame-template.html 包裹（Apple 主题），Open Design 的 buildSrcdoc 最小外壳。谨迹需要自己的包裹器：注入谨迹主题 CSS 变量 + 琥珀金 accent + 系统字体。</div>
