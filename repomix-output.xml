#!/usr/bin/env bash

set -euo pipefail

usage() {
  echo "Usage: refs/scripts/journal-note \"<核心主题>\" [--date YYYY-MM-DD]" >&2
  exit 1
}

if [[ $# -lt 1 ]]; then
  usage
fi

title=""
note_date=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --date)
      shift
      [[ $# -gt 0 ]] || usage
      note_date="$1"
      ;;
    *)
      if [[ -n "$title" ]]; then
        usage
      fi
      title="$1"
      ;;
  esac
  shift
done

[[ -n "$title" ]] || usage

if [[ "$title" == *"/"* ]]; then
  echo "Title cannot contain '/'." >&2
  exit 1
fi

if [[ -n "$note_date" ]]; then
  [[ "$note_date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || {
    echo "Date must be YYYY-MM-DD." >&2
    exit 1
  }
else
  note_date="$(date '+%Y-%m-%d')"
fi

year="${note_date:2:2}"
month="${note_date:5:2}"
day="${note_date:8:2}"
folder="${year}${month}"

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "${script_dir}/../.." && pwd)"
target_dir="${repo_root}/${folder}"
template_path="${repo_root}/refs/工作日记模版.md"

mkdir -p "${target_dir}"

base_name="${day}-${title}"
target_path="${target_dir}/${base_name}.mdx"
counter=2
while [[ -e "${target_path}" ]]; do
  suffix=$(printf '%02d' "${counter}")
  target_path="${target_dir}/${base_name}-${suffix}.mdx"
  counter=$((counter + 1))
done

created_at="$(date '+%Y-%m-%d %H:%M:%S %z')"

if [[ -f "${template_path}" ]]; then
  perl -0pe \
    "s/\\{\\{title\\}\\}/${title}/g; s/\\{\\{created_at\\}\\}/${created_at}/g" \
    "${template_path}" > "${target_path}"
else
  cat > "${target_path}" <<MDXEOF
---
tags: [journal]
summary:
sources:
---

# ${title}

<Subtitle>结论先行，细节在后</Subtitle>

<Section>

## 背景与结论

<Callout type="info" title="核心结论">

（一句话：发生了什么、结论是什么）

</Callout>

</Section>

<Section>

## 关键事实

<Timeline
  items={[
    { time: '', title: '', desc: '' },
  ]}
/>

</Section>

<Section>

## 判断与推理

-

</Section>

<Section>

## 行动与待确认

<Checklist
  items={[
    { text: '', checked: false },
  ]}
/>

</Section>

<Section>

## 关联

<RelatedEntry path="" label="" />

</Section>

*创建时间: ${created_at}*
MDXEOF
fi

echo "${target_path}"
</file>

