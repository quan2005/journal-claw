                    messages={messages}
                    isStreaming={isStreaming}
                    usage={usage}
                    stats={stats}
                    pendingQueue={pendingQueue}
                    initialInput={chatInitialText}
                    onSend={send}
                    onCancel={cancel}
                    onRetry={retry}
                    onEditAndResend={editAndResend}
                    onRemovePendingItem={removePendingItem}
