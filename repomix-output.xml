// Lightweight MDX parser that replaces @mdx-js/mdx for our constrained JSX subset:
// - Named components only (starts with uppercase)
// - String, number, boolean, array, object props
// - No JS expressions, no imports/exports
// - Self-closing tags
// - Nested components
// Everything else → treated as markdown, rendered by ReactMarkdown.

export interface MdxMarkdown {
  type: 'markdown'
  content: string
}

export interface MdxComponent {
  type: 'component'
  name: string
  props: Record<string, unknown>
  children: MdxNode[]
}

export type MdxNode = MdxMarkdown | MdxComponent

// ── Props parser ───────────────────────────────────────────────────────────

function parseExprValue(expr: string): unknown {
  // Try JSON first (numbers, booleans, quoted strings, arrays, plain objects)
  try { return JSON.parse(expr) } catch { /* not JSON */ }
  // Try JS expression
  try { return new Function(`return (${expr})`)() } catch { /* nope */ }
  return expr
}

function parseProps(propsStr: string): Record<string, unknown> {
  const props: Record<string, unknown> = {}
  let i = 0

  while (i < propsStr.length) {
    // Skip whitespace (including newlines)
    while (i < propsStr.length && /\s/.test(propsStr[i])) i++
    if (i >= propsStr.length) break

    // Prop name
    const nameStart = i
    while (i < propsStr.length && /[a-zA-Z0-9_]/.test(propsStr[i])) i++
    const name = propsStr.slice(nameStart, i)
    if (!name) break

    // Skip whitespace
    while (i < propsStr.length && /\s/.test(propsStr[i])) i++

    if (i < propsStr.length && propsStr[i] === '=') {
      i++
      while (i < propsStr.length && /\s/.test(propsStr[i])) i++
      if (i >= propsStr.length) break

      if (propsStr[i] === '"' || propsStr[i] === "'") {
        const quote = propsStr[i]
        i++
        let val = ''
        while (i < propsStr.length && propsStr[i] !== quote) {
          if (propsStr[i] === '\\' && i + 1 < propsStr.length) { val += propsStr[i + 1]; i += 2; continue }
          val += propsStr[i]
          i++
        }
        i++ // closing quote
        props[name] = val
      } else if (propsStr[i] === '{') {
        let depth = 1
        i++
        const exprStart = i
        while (i < propsStr.length && depth > 0) {
          if (propsStr[i] === '{') depth++
          else if (propsStr[i] === '}') depth--
          i++
        }
        props[name] = parseExprValue(propsStr.slice(exprStart, i - 1).trim())
      }
    } else {
      // Boolean attribute
      props[name] = true
    }
  }

  return props
}

// ── Tag matcher ────────────────────────────────────────────────────────────

interface TagInfo {
  name: string
  props: Record<string, unknown>
  selfClosing: boolean
  /** Position right after > of opening tag */
  contentStart: number
  /** Position of </Name> */
  closeStart: number
  /** Position right after </Name> or /> */
  end: number
}

function findCloseTag(source: string, start: number, name: string): number {
  const closeStr = `</${name}>`
  let depth = 1
  let i = start

  while (i < source.length) {
    // Check for nested open of same name: <Name followed by space, >, /, or newline
    if (source[i] === '<' && source[i + 1] !== '/') {
      const after = source[i + 1]
      if (after && /[A-Za-z]/.test(after)) {
        const rest = source.slice(i + 1)
        const nameMatch = rest.match(/^([A-Za-z][a-zA-Z0-9]*)/)
        if (nameMatch && nameMatch[1] === name) {
          const nextChar = rest[nameMatch[1].length]
          if (!nextChar || /[\s/>]/.test(nextChar)) {
            depth++
          }
        }
      }
    }

    if (source.slice(i, i + closeStr.length) === closeStr) {
      depth--
      if (depth === 0) return i
    }

    i++
  }

  return -1
}

function matchTag(source: string, pos: number): TagInfo | null {
  if (source[pos] !== '<') return null

  // Must be a letter right after <
  const first = source[pos + 1]
  if (!first || !/[A-Za-z]/.test(first)) return null

  const nameMatch = source.slice(pos + 1).match(/^([A-Za-z][a-zA-Z0-9]*)/)
  if (!nameMatch) return null
  const name = nameMatch[1]

  // Find end of opening tag: look for > or />
  let j = pos + 1 + name.length
  let inString = false
  let stringChar = ''
  while (j < source.length) {
    const ch = source[j]
    if (inString) {
      if (ch === '\\') { j += 2; continue }
      if (ch === stringChar) inString = false
      j++
      continue
    }
    if (ch === '"' || ch === "'") { inString = true; stringChar = ch; j++; continue }
    if (ch === '>') break
    j++
  }
  if (j >= source.length) return null

  const propsStr = source.slice(pos + 1 + name.length, j)
  const props = parseProps(propsStr)

  // Self-closing: <Name />
  if (source[j - 1] === '/' && source[j] === '>') {
    return { name, props, selfClosing: true, contentStart: j + 1, closeStart: j - 1, end: j + 1 }
  }

  const contentStart = j + 1
  const closePos = findCloseTag(source, contentStart, name)
  if (closePos === -1) return null

  return {
    name,
    props,
    selfClosing: false,
    contentStart,
    closeStart: closePos,
    end: closePos + `</${name}>`.length,
  }
}

// ── Code fence protection ──────────────────────────────────────────────────

const PLACEHOLDER_PREFIX = '\x00MDX_'

function protectCode(source: string): { clean: string; restore: (text: string) => string } {
  const store = new Map<string, string>()
  let counter = 0

  const replace = (_: string, match: string) => {
    const key = `${PLACEHOLDER_PREFIX}${counter++}`
    store.set(key, match)
    return key
  }

  // Fenced code blocks
  let result = source.replace(/```[\s\S]*?```/g, (m) => replace('', m))
  // Inline code
  result = result.replace(/`[^`\n]+`/g, (m) => replace('', m))

  const restore = (text: string): string => {
    for (const [k, v] of store) text = text.split(k).join(v)
    return text
  }

  return { clean: result, restore }
}

// ── Main parser ────────────────────────────────────────────────────────────

function parseNodes(source: string): MdxNode[] {
  const nodes: MdxNode[] = []
  let i = 0

  while (i < source.length) {
    // Skip whitespace-only between components/markdown
    while (i < source.length && (source[i] === ' ' || source[i] === '\t')) i++
    if (i >= source.length) break

    const tag = matchTag(source, i)

    if (tag) {
      if (tag.selfClosing) {
        nodes.push({ type: 'component', name: tag.name, props: tag.props, children: [] })
      } else {
        const inner = source.slice(tag.contentStart, tag.closeStart)
        nodes.push({
          type: 'component',
          name: tag.name,
          props: tag.props,
          children: parseNodes(inner),
        })
      }
      i = tag.end
      // Skip trailing newline after a component tag
      if (source[i] === '\n') i++
    } else {
      // Collect markdown text until next <
      let next = source.indexOf('<', i + 1)
      // Don't collect empty segments at the end
      while (next !== -1 && !matchTag(source, next)) {
        next = source.indexOf('<', next + 1)
      }
      const end = next === -1 ? source.length : next
      const text = source.slice(i, end).trim()
      if (text) {
        nodes.push({ type: 'markdown', content: text })
      }
      i = end
    }
  }

  return nodes
}

/**
 * Parse MDX source string into a tree of markdown and component nodes.
 * ~0.5–5ms for typical journal entries (vs ~500ms–2s for @mdx-js/mdx).
 */
export function parseMdx(source: string): MdxNode[] {
  const { clean, restore } = protectCode(source)
  const nodes = parseNodes(clean)

  // Restore code placeholders in markdown content
  function walk(list: MdxNode[]) {
    for (const node of list) {
      if (node.type === 'markdown') {
        node.content = restore(node.content)
      } else {
        walk(node.children)
      }
    }
  }
  walk(nodes)

  return nodes
}
