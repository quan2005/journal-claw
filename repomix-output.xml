                onHistorySelect={(id: string) => openChatPanel(id)}
              />
            </div>
          </>
        )}
      </div>

      {mergeSource && (
        <MergeIdentityDialog
          source={mergeSource}
          onClose={() => setMergeSource(null)}
          onMerged={() => {
            setMergeSource(null)
