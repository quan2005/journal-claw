    .final-flow{display:flex;align-items:center;justify-content:center;gap:8px;flex-wrap:wrap;margin:16px 0}
    .final-node{background:rgba(200,147,59,0.2);border:1px solid rgba(200,147,59,0.3);padding:6px 14px;border-radius:6px;font-size:13px;font-weight:500}
    .final-arrow{opacity:0.5;font-size:14px}

    /* ========== 主题切换 ========== */
    .theme-toggle{
      position:fixed;top:16px;right:16px;z-index:100;
