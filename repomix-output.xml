    } else {
        model
    };

    let form = reqwest::multipart::Form::new()
        .part("file", file_part)
        .text("model", model_name.to_string());

    let timeout_secs = (duration_secs * 5.0).max(300.0) as u64;
    let client = reqwest::Client::builder()
        .timeout(Duration::from_secs(timeout_secs))
        .build()
        .unwrap_or_default();

