              <div
                style={{
                  fontSize: 'var(--text-base)',
                  color: 'var(--detail-summary)',
                  lineHeight: 1.8,
                  marginBottom: (pickDisplayTags(entry.tags, Infinity).length > 0 || entry.sources.length > 0) ? 10 : 0,
