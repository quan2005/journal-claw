              if (!entry) return null
              return (
                <TreeItem key={pinned.path} itemType="journal" entry={entry}
                  isToday={isToday(entry)}
                  isSelected={selected?.path === pinned.path}
                  onClick={() => handleSelect('journal', pinned.path)}
