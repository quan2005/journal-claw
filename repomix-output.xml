  .sidebar-list {
    flex: 1;
    overflow-y: auto;
    padding: 0 8px;
  }

  .month-group {
    margin-bottom: 16px;
  }
  .month-label {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
