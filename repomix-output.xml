html,
body,
#root {
  height: 100%;
  width: 100%;
  background: var(--bg);
  font-family: var(--font-body);
  -webkit-font-smoothing: antialiased;
  overflow: hidden;
}

#root {
  display: flex;
  flex-direction: column;
  animation: app-enter 0.18s ease-out;
}

[data-tauri-drag-region] {
  -webkit-app-region: drag;
}

[data-tauri-drag-region] * {
  -webkit-app-region: no-drag;
}

/* ── Markdown body — ordered list numbers ───────────────────── */
.md-body ol li {
  list-style: decimal;
  display: list-item;
  color: var(--md-text);
  font-size: var(--text-md);
  line-height: 1.75;
}

.md-body ol li::marker {
  color: var(--md-bullet);
  font-weight: var(--font-semibold);
}

/* ── Inline code only (not inside pre) ───────────────────────── */
.md-body :not(pre) > code {
  font-family: var(--font-mono);
  font-size: 0.88em;
  background: var(--md-code-bg);
  color: var(--md-code-text);
  padding: 1px 5px;
  border-radius: 4px;
}

/* ── Markdown links ────────────────────────────────────────────── */
.md-body .md-link {
  color: var(--md-link);
  text-decoration: none;
  border-bottom: 1px solid transparent;
  transition:
    color 0.15s var(--ease-out),
    opacity 0.15s var(--ease-out);
}
.md-body .md-link:hover {
  color: var(--md-link-hover);
  opacity: 0.8;
}

/* ── Checklist checkbox alignment ───────────────────────────── */
.md-body .task-list-item input[type='checkbox'] {
  display: block;
  flex-shrink: 0;
}

/* ── Mic button hover ───────────────────────────────────────── */
.mic-btn {
  will-change: transform, opacity;
  transition:
    background-color 0.18s ease,
    transform 0.18s ease,
    opacity 0.18s ease;
}
.mic-btn[data-recording='false']:hover {
  background: var(--record-btn-hover) !important;
  transform: scale(1.04);
}
.mic-btn:active {
  opacity: 0.85;
}
.mic-btn[data-recording='true']:hover {
  opacity: 0.9;
}
.mic-btn:focus-visible {
  outline: 2px solid color-mix(in srgb, var(--record-btn) 68%, white);
  outline-offset: 3px;
}

/* ── Scrollbar ───────────────────────────────────────────── */
* {
  scrollbar-width: thin;
  scrollbar-color: var(--scrollbar-thumb) transparent;
}
*::-webkit-scrollbar {
  width: 4px;
  height: 4px;
}
*::-webkit-scrollbar-track {
  background: transparent;
}
*::-webkit-scrollbar-thumb {
  background: var(--scrollbar-thumb);
  border-radius: 2px;
}
*::-webkit-scrollbar-thumb:hover {
  background: var(--scrollbar-thumb-hover);
}

/* ── Cmd+V kbd button glow pulse ────────────────────────── */
@keyframes kbd-glow-pulse {
  0%,
  100% {
    opacity: 0.4;
  }
  50% {
    opacity: 1;
  }
}
.dock-kbd-pulse {
  animation: kbd-glow-pulse 2.4s ease-in-out infinite;
}

/* ── Dock textarea ─────────────────────────────────────── */
.dock-textarea {
  font-family: var(--font-mono);
}

/* ── Dock textarea placeholder ─────────────────────────── */
.dock-textarea::placeholder {
  color: var(--item-meta);
  opacity: 0.25;
}

/* ── Table: auto layout — first column stays compact ────────── */
.md-body table td:first-child {
  white-space: nowrap;
  max-width: 200px;
  overflow: hidden;
  text-overflow: ellipsis;
}

