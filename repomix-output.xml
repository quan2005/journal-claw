        );
        std::fs::remove_dir_all(&tmp).ok();
    }

    // ── strip_surrounding_quotes tests ─────────────────────────────────────

    #[test]
    fn strip_quotes_ascii_double() {
        assert_eq!(strip_surrounding_quotes(r#""摘要内容""#), "摘要内容");
    }

    #[test]
